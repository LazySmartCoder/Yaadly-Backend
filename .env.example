# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=*

# Database (unset/leave defaults for local SQLite by setting USE_SQLITE=True)
USE_SQLITE=True
POSTGRES_DB=yaadly
POSTGRES_USER=yaadly
POSTGRES_PASSWORD=yaadly
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Auth / JWT
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=14
GOOGLE_CLIENT_ID=203246620684-aqo3vjc4k4qr5une1k10le7c3sm83qav.apps.googleusercontent.com

# Speech-to-text (Google Cloud). Set EITHER a path to a service-account JSON key
# file, OR paste the key's contents inline as GOOGLE_SPEECH_CREDENTIALS_JSON.
# The service account needs the "Cloud Speech-to-Text API" enabled.
# GOOGLE_SPEECH_CREDENTIALS_FILE=/secrets/gcp-stt-service-account.json
# GOOGLE_SPEECH_CREDENTIALS_JSON={"type":"service_account",...}
STT_LANGUAGE_CODE=en-US
STT_MAX_AUDIO_BYTES=12582912

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000

# Misc
TIME_ZONE=UTC
