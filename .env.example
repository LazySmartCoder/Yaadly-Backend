# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=*

# Database (unset/leave defaults for local SQLite by setting USE_SQLITE=True)
USE_SQLITE=True
POSTGRES_DB=yaadly
POSTGRES_USER=yaadly
POSTGRES_PASSWORD=yaadly
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Auth / JWT
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=14
GOOGLE_CLIENT_ID=203246620684-aqo3vjc4k4qr5une1k10le7c3sm83qav.apps.googleusercontent.com

# Gemini (journalizing)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite

# Firebase Cloud Messaging (automated daily push notifications).
# Provide either a path to the Firebase service-account JSON file on the server,
# or paste the raw JSON into FCM_SERVICE_ACCOUNT_JSON. FCM_PROJECT_ID can be
# omitted when the service account includes a project_id.
FCM_SERVICE_ACCOUNT_PATH=/root/yaadly/firebase-service-account.json
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=
FCM_BATCH_SIZE=200

# Daily push slot times in the server's TIME_ZONE ("HH:MM").
FCM_MORNING_AT=09:00
FCM_AFTERNOON_AT=13:00
FCM_EVENING_AT=22:00

# DigitalOcean Spaces (S3-compatible object storage) for uploaded media
# (voice-entry audio). Leave USE_S3_STORAGE=False for local-disk media.
USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=your-spaces-access-key
AWS_SECRET_ACCESS_KEY=your-spaces-secret-key
AWS_STORAGE_BUCKET_NAME=yaadlybucket
AWS_S3_ENDPOINT_URL=https://sfo3.digitaloceanspaces.com
AWS_S3_REGION_NAME=sfo3

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000

# Misc
TIME_ZONE=UTC
