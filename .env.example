# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=*

# Database (unset/leave defaults for local SQLite by setting USE_SQLITE=True)
USE_SQLITE=True
POSTGRES_DB=yaadly
POSTGRES_USER=yaadly
POSTGRES_PASSWORD=yaadly
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Auth / JWT
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=14
GOOGLE_CLIENT_ID=121554443587-p34frc2hfd21ph1p7guvvpth1arcqlsu.apps.googleusercontent.com

# Gemini (journalizing)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite

# Firebase Cloud Messaging.
# Provide either a path to the Firebase service-account JSON file on the server,
# or paste the raw JSON into FCM_SERVICE_ACCOUNT_JSON. FCM_PROJECT_ID can be
# omitted when the service account includes a project_id.
# When running under docker compose the path is overridden to the container
# path (/app/firebase-service-account.json) and the host file is mounted in.
FCM_SERVICE_ACCOUNT_PATH=/root/yaadly/firebase-service-account.json
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=

# Android notification channel FCM background/terminated messages land on.
# Must match the channel the app creates via flutter_local_notifications.
FCM_CHANNEL_ID=yaadly_messages

# Cloudflare R2 (S3-compatible object storage) for uploaded media (entry photos).
# Leave USE_S3_STORAGE=False for local-disk media.
# Create an R2 API token (R2 -> Manage R2 API Tokens -> Create API token) with
# Object Read & Write permission. The bucket region is always "auto".
USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
AWS_STORAGE_BUCKET_NAME=yaadly
AWS_S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_S3_REGION_NAME=auto
AWS_SIGNING_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SIGNING_SECRET_ACCESS_KEY=your-r2-secret-access-key

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000

# Misc
TIME_ZONE=Asia/Kolkata
